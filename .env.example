# ============================================================================
# Configuración del Bot DCA "3 Cargadores" (Modo Demostración / Portafolio)
# ============================================================================
# NOTA: NO se necesitan claves de API reales para ejecutar el proyecto.
# El bot consume únicamente el endpoint público de precios (ticker) de BingX.

# Valor en USDT asignado a cada una de las 90 balas simuladas (margen antes de 5X)
VALOR_BALA_USDT=10

# Modo demostración (Hardcodeado en True en bot.py por seguridad; no envía órdenes)
DRY_RUN=True

# ---- Opcionales (solo lectura de saldo si se desea probar autenticación) ----
BINGX_API_KEY=
BINGX_SECRET_KEY=
